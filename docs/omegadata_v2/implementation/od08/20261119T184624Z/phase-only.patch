+
+    def __post_init__(self) -> None:
+        text(self.policy_version)
+        if self.view not in {"MEMBERSHIP", "RESEARCH", "LIQUIDITY", "EXECUTION"}:
+            raise ValueError("CONSUMER_VIEW")
+
+
+@dataclass(frozen=True)
+class UniverseContext:
