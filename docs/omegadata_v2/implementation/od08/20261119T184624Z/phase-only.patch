+        )
+        for i in range(count)
+    )
+    identity = MemoryIdentityRepository((Issuer("issuer-a"),), securities, listings, claims)
+    members = tuple(
+        replace(
+            member,
+            claim=replace(
+                member.claim, membership_id="membership-" + str(i), symbol=claims[i].symbol
+            ),
+            event_id="event-" + str(i),
+            security_id=securities[i].security_id,
+            listing_id=listings[i].listing_id,
+        )
+        for i in range(count)
+    )
+    expected = tuple(sorted(s.security_id for s in securities))
+    x = replace(
