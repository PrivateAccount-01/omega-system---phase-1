+def test_liquidity_median_threshold_uses_exact_ratio_at_extreme_scale():
+    from omegadata.universe.eligibility import liquidity
+
+    c, x, m, p = liquid_case()
+    p = replace(
+        p,
+        lookback_sessions=2,
+        minimum_completed_sessions=2,
+        minimum_observation_coverage=Decimal(1),
+        minimum_median_turnover=Decimal("1E64"),
+    )
+    # Literal bounded mathematical scalars, not financial observations:
+    # ((2*10^64 - 10) + (10 - 10^-63))/2 = 10^64 - 5*10^-64.
+    large = Decimal((0, (1,) + (9,) * 63, 1))
+    small = Decimal((0, (9,) * 64, -63))
+    rows = (
+        observation(x, observation_id="a", session_date=D + timedelta(days=1), turnover=large),
+        observation(x, observation_id="b", session_date=D + timedelta(days=2), turnover=small),
+    )
+    status, detail = liquidity(m, x, rows, D + timedelta(days=2), K + timedelta(days=3), p)
+    assert status == "EXCLUDED_BY_POLICY"
