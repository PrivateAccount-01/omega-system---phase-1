+
+    def resolve_listing_id(
+        self,
+        listing_id: str,
+        valid_at: date,
+        known_at: datetime,
+        evidence_policy: Policy = "STRICT",
+    ) -> Resolution:
+        """OD07 dependency: stable-ID lookup after observation-date symbol resolution."""
+        text(listing_id)
+        query_time(known_at)
+        if type(valid_at) is not date:
+            raise ValueError("DATE_REQUIRED")
+        ends = revision_ends(self.claims)
+        selected = tuple(
+            c
+            for c in self.claims
+            if c.listing_id == listing_id
+            and c.valid_from <= valid_at
+            and (c.valid_to is None or valid_at < c.valid_to)
+            and (c.known_from is None or c.known_from <= known_at)
+            and (c.known_to is None or known_at < c.known_to)
+            and (c.claim_id not in ends or known_at < ends[c.claim_id])
+        )
+        keys = {(c.exchange, c.symbol, c.series) for c in selected}
+        if not keys:
+            return Resolution("UNKNOWN", reason="STABLE_LISTING_COVERAGE_UNKNOWN")
+        if len(keys) != 1:
