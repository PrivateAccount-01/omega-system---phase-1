+        "rollback_seconds": rollback,
+        "peak_tracemalloc_bytes": peak,
+        "snapshot_bytes": len(out.canonical_json.encode()),
+        "query_plan": plan,
+        "candidate_upper_bound": count,
+        "deterministic_digest": out.snapshot_digest,
+    }
+    (root / "result.json").write_text(json.dumps(result, indent=2))
