+) -> None:
+    x, r = pin.context, pin.raw
+    if type(ref) is not b.ReferenceObservation:
+        refuse("BLOCKED_IDENTITY", "BOUND_REFERENCE_IDENTITY_REQUIRED")
+    expected_security = (
