+        if not evidence_id:
+            return deny("EVIDENCE_ID_MISSING")
+        if (
+            not isinstance(as_of_knowledge, datetime)
+            or as_of_knowledge.tzinfo is None
+            or as_of_knowledge.utcoffset() is None
+        ):
