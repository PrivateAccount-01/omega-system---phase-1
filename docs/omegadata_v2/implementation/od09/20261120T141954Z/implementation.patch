+    measure("transaction_rollback", rollback)
+    db.close()
+    start = time.perf_counter()
+    db = PersistentRepository(url, disposable_root=out)
+    assert db.serialize_history() == before
+    samples["restart_recovery"] = [time.perf_counter() - start]
