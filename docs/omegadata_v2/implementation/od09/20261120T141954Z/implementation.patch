+                "AMBIGUOUS",
+                tuple(sorted(c.claim_id for c in selected)),
+                reason="OVERLAPPING_STABLE_LISTING_CLAIMS",
+            )
+        exchange, symbol, series = next(iter(keys))
+        result = self.resolve_listing(exchange, symbol, series, valid_at, known_at, evidence_policy)
+        if result.state == "RESOLVED" and result.listing_id != listing_id:
+            return Resolution("CONFLICTING", result.claim_ids)
+        return result
