+    e = Evidence("canary-e", "NON_MARKET_CANARY", "UNVERIFIED", "PERMITTED", "canary-review")
+    c = IdentifierClaim(
+        "claim-a",
+        "listing-a",
+        "CANARY-X",
+        "TOKEN",
+        "SERIES",
+        date(2001, 1, 1),
+        None,
+        datetime(2001, 1, 1, tzinfo=UTC),
+        None,
