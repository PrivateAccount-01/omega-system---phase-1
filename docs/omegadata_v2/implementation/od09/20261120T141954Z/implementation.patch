+        assert out.included_member_ids == expected
+    dbpath = root / "bookkeeping.sqlite"
+    url = "sqlite:///" + str(dbpath)
+    db = UniverseRepository(url, disposable_root=root)
+    tick = time.perf_counter()
+    db.seed_context(x, policy)
+    insert = time.perf_counter() - tick
+    tick = time.perf_counter()
+    db.pin_context("pin", x, D, K, policy)
+    db.admit_snapshot("pin", out)
+    admission = time.perf_counter() - tick
+    tick = time.perf_counter()
+    history = get_membership_history(x, members[0].event_id)
+    history_time = time.perf_counter() - tick
+    assert len(history) == 1
+    correction = replace(
+        members[0],
+        claim=replace(
+            members[0].claim,
+            membership_id="correction",
+            known_from=K + timedelta(days=1),
+            supersedes_membership_id=members[0].revision_id,
+        ),
+        revision_number=2,
+    )
+    tick = time.perf_counter()
+    db.append_membership(correction)
+    append = time.perf_counter() - tick
+    changed = replace(x, memberships=(*members, correction))
+    assert (
+        get_universe_as_of(changed, D, K, policy, x.source_snapshot_id).snapshot_digest
+        == out.snapshot_digest
+    )
+    plan = db.query_plan(x.definition.universe_id, D, K)
+    db.close()
+    tick = time.perf_counter()
+    db = UniverseRepository(url, disposable_root=root)
+    assert db.replay_context("pin").snapshot_digest == out.snapshot_digest
+    restart = time.perf_counter() - tick
+    tick = time.perf_counter()
