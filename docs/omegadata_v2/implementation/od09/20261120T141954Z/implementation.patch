+def test_missing_downstream_proof_blocks_reprocess_context(tmp_path):
+    c, db, x, newcontext, correction = correction_case(tmp_path)
+    # A separately declared dependent snapshot cannot be cleared by an unrelated result.
+    old = replace(x.left[0], universe_snapshot_id="dependent-universe")
