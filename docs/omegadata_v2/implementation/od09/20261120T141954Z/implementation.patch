+                for operation in ("UPDATE", "DELETE"):
+                    connection.exec_driver_sql(
+                        f"CREATE TRIGGER IF NOT EXISTS {table}_{operation}_immutable BEFORE {operation} ON {table} BEGIN SELECT RAISE(ABORT,'OD07_APPEND_ONLY'); END"
