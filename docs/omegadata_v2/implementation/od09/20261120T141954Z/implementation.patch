+                    Link(
+                        a.action_id,
+                        a.source_artifact_identity,
+                        identity_ref,
+                        calendar_ref,
+                        raw.artifact_id,
+                        VERSION,
+                        policy.profile,
+                        canonical(a),
+                        f,
+                        "decimal80-final-half-up/v1",
+                        x.known_at,
