+    def append_correction(self, claim: IdentifierClaim) -> MemoryIdentityRepository:
+        if claim.supersedes_claim_id is None:
+            raise ValueError("SUPERSESSION_REQUIRED")
+        return replace(self, claims=(*self.claims, claim))
+
+    def resolve_listing(
+        self,
+        exchange: str,
+        symbol: str,
+        series: str,
+        valid_at: date,
+        known_at: datetime,
