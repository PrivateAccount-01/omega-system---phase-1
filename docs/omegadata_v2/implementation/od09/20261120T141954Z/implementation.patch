+            for a in ordered:
+                if policy.profile == "EXECUTION" and a.action_type in {
+                    "SUSPENSION",
+                    "DELISTING",
+                    "DELISTING_VOLUNTARY",
+                    "DELISTING_REGULATORY",
+                }:
