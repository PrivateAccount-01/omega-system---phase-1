+def test_two_connection_review_race(tmp_path):
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+
+    from sqlalchemy.exc import IntegrityError
+
+    from omegadata.reconciliation.engine import reconcile_context
+    from omegadata.reconciliation.repository import ReconciliationRepository
+    from omegadata.reconciliation.reviews import ReviewRevision, advance_review
+
+    c, x, left, right = controls()
+    url = "sqlite:///" + str(tmp_path / "race.sqlite")
+    first = ReconciliationRepository(url, disposable_root=tmp_path)
+    first.pin_comparison(x)
+    result = reconcile_context(x)[0]
+    first.admit_results(x.context_id, (result,))
+    root = ReviewRevision(
+        "r0",
+        "review",
+        result.reconciliation_id,
+        "OPEN",
+        K,
+        "data-review",
+        ("original",),
+        "v",
+        None,
+        ("listing-a",),
+        "CRITICAL",
+    )
+    first.append_review(root)
+    second = ReconciliationRepository(url, disposable_root=tmp_path)
+    barrier = Barrier(2)
+
+    def append(db, identity):
+        child = advance_review(
+            root,
+            "UNDER_REVIEW",
+            identity,
+            K + timedelta(seconds=1),
+            "anonymous",
+            "structural race",
+            (),
+            mode="CANARY_ONLY",
+        )
+        barrier.wait(timeout=5)
+        try:
+            db.append_review(child)
+            return "COMMITTED"
+        except (ValueError, IntegrityError):
+            return "REFUSED"
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        a = pool.submit(append, first, "r1")
+        b = pool.submit(append, second, "r2")
+        assert sorted((a.result(timeout=10), b.result(timeout=10))) == ["COMMITTED", "REFUSED"]
+    assert len(first.get_review_history("review")) == 2
+    first.close()
+    second.close()
+
