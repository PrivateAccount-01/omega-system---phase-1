+        out = run(pin)
+        db.append_bound_result(out, "context")
+        if case == "rollback-context":
+            with pytest.raises(ValueError):
+                db.pin_context(replace(pin, raw=replace(raw, observation_id="different")))
+            assert db.get_result(out.output_digest) == out.canonical_json
+        db.close()
+        db = AdjustmentRepository(url, disposable_root=tmp_path)
+        assert db.get_result(out.output_digest) == out.canonical_json
