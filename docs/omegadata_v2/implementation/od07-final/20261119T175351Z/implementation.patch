+                f.numerator is not None
+                and f.denominator is not None
+                and f.volume_numerator is not None
+                and f.volume_denominator is not None
+            )
+            n *= f.numerator
+            d *= f.denominator
+            vn *= f.volume_numerator
+            vd *= f.volume_denominator
