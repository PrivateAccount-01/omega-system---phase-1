+)
+def test_semantic_review(case, tmp_path, monkeypatch):
+    from omegadata.adjustments.repository import AdjustmentRepository
+    from omegadata.session_calendar import SessionClaim
+
+    b, c, x, a, raw, h, p, params, pin, run = setup_bound()
+    if case in {"independent-oracle", "independent-lineage"}:
+        from omegadata.adjustments import admission
+
+        out = run(pin)
+        if case == "independent-oracle":
+            bad = replace(out, calculation=replace(out.calculation, adjusted_price=Decimal(999)))
+        else:
+            link = replace(out.calculation.adjustment_factor_chain[0], source_artifact_id="wrong")
+            bad = replace(
+                out, calculation=replace(out.calculation, adjustment_factor_chain=(link,))
+            )
+        monkeypatch.setattr(admission, "calculate_bound_chain", lambda ignored: bad)
+        db = AdjustmentRepository("sqlite:///:memory:", disposable_root=tmp_path)
+        db.append_action(a)
+        with pytest.raises(ValueError):
+            db.pin_context(pin)
+    elif case in {
+        "valid-session-missing-lot",
+        "closed-session",
+        "delisted-execution",
+        "canary-execution-promotion",
+    }:
+        session = SessionClaim(
+            "raw-session",
+            "MATH",
+            raw.raw.trade_date,
+            "CLOSED" if case == "closed-session" else "REGULAR",
+            "Asia/Kolkata",
+            "cal-v1",
+            a.evidence,
+            K,
+            None,
+        )
+        calendar = replace(x.calendar, claims=(*x.calendar.claims, session))
+        if case == "delisted-execution":
+            claim = replace(x.identity_repository.claims[0], lifecycle="DELISTED")
+            x = replace(x, identity_repository=replace(x.identity_repository, claims=(claim,)))
+        parts = setup_bound(
+            (),
+            context=replace(x, calendar=calendar),
+            basis=b.BasisPolicy("EXECUTION", "RAW_UNADJUSTED", raw.raw.trade_date),
+        )
+        pin = parts[8]
+        if case == "canary-execution-promotion":
+            terms = b.ExecutionConstraints(
+                "s",
+                "l",
+                "MATH",
+                raw.raw.trade_date,
+                K,
+                a.evidence,
+                10,
+                "20",
+                "WHOLE_UNITS",
+                "CANARY_ONLY",
+                "CLEAR",
+            )
+            pin = replace(pin, execution_constraints=terms)
+        out = run(pin)
+        assert out.status == "CALCULATED" and not out.execution_eligibility
+        expected = {
+            "valid-session-missing-lot": "BLOCKED_LOT_OR_SETTLEMENT_UNKNOWN",
+            "closed-session": "BLOCKED_CALENDAR",
+            "delisted-execution": "BLOCKED_LIFECYCLE",
+            "canary-execution-promotion": "BLOCKED_NON_MARKET_CONTROL",
+        }[case]
+        assert out.execution_status == expected
+    elif case == "future-identity":
+        old = x.identity_repository.claims[0]
+        correction = replace(
+            old,
+            claim_id="future",
+            symbol="FUTURE",
+            known_from=x.known_at + timedelta(days=1),
+            supersedes_claim_id=old.claim_id,
+        )
+        changed = replace(
+            x, identity_repository=replace(x.identity_repository, claims=(old, correction))
+        )
+        assert calculate(setup_bound(context=changed)).output_digest == run(pin).output_digest
+    elif case == "unreviewed-merger":
+        from omegadata.identity import Listing, Security
+
+        old = x.identity_repository.claims[0]
+        new_listing = Listing("successor-listing", "successor-security", "MATH")
+        successor = replace(old, claim_id="successor", listing_id="successor-listing", valid_from=D)
+        repo = replace(
+            x.identity_repository,
+            securities=(*x.identity_repository.securities, Security("successor-security", "i")),
+            listings=(*x.identity_repository.listings, new_listing),
+            claims=(replace(old, valid_to=D), successor),
+        )
+        assert (
+            calculate(setup_bound(context=replace(x, identity_repository=repo))).status
+            == "BLOCKED_IDENTITY"
+        )
+    elif case == "undefined-forward-rights":
+        bits = rights_case()
+        raw = replace(bits[4], raw=replace(bits[4].raw, trade_date=D, price=Decimal(90)))
+        assert (
+            calculate(
+                setup_bound(
+                    bits[5].actions,
+                    raw=raw,
+                    basis=b.BasisPolicy("PRICE_RETURN", "FORWARD_ADJUSTED", D - timedelta(days=1)),
+                )
+            ).status
+            == "UNSUPPORTED_POLICY"
+        )
+    elif case == "schema-version":
+        from sqlalchemy import create_engine
+
+        from omegadata.adjustments.repository import M, version
+
+        url = "sqlite:///" + str(tmp_path / "unknown.sqlite")
+        engine = create_engine(url)
+        with engine.begin() as connection:
+            M.create_all(connection)
+            connection.execute(version.insert().values(version="unrecognized"))
+        engine.dispose()
+        with pytest.raises(ValueError):
+            AdjustmentRepository(url, disposable_root=tmp_path)
