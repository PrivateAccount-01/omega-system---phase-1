+            action_id="b",
+            action_revision=2,
+            supersedes_action_id="a",
+            known_from=x.known_at + timedelta(days=1),
+            parameters=replace(a.parameters, subscription_price=Decimal(80)),
+        )
+        assert calculate(setup_bound((a, future))).adjusted_price == Decimal(108)
+    elif case == "wrong-venue-symbol":
+        r = replace(raw, raw=replace(raw.raw, exchange="OTHER"))
+        assert calculate(setup_bound(raw=r)).status == "BLOCKED_IDENTITY"
+    elif case == "ambiguous-identity":
+        old = x.identity_repository.claims[0]
+        repo = replace(x.identity_repository, claims=(old, replace(old, claim_id="duplicate")))
+        assert (
+            calculate(setup_bound(context=replace(x, identity_repository=repo))).status
+            == "BLOCKED_IDENTITY"
+        )
+    elif case == "strict-no-promotion":
+        out = calculate(setup_bound(context=replace(x, mode="STRICT")))
+        assert (
+            out.status == "BLOCKED_EVIDENCE"
+            and not out.execution_eligibility
+            and not out.publication_eligibility
+        )
+    else:
+        from omegadata.adjustments.repository import AdjustmentRepository
+
+        url = "sqlite:///" + str(tmp_path / "bound.sqlite")
+        if case == "legacy-migration":
+            from sqlalchemy import create_engine
+
+            from omegadata.adjustments.repository import M, version
+
+            engine = create_engine(url)
+            with engine.begin() as connection:
+                M.create_all(
+                    connection,
+                    tables=[
+                        M.tables[n]
+                        for n in ["od07_schema", "od07_action", "od07_result", "od07_result_action"]
+                    ],
+                )
+                connection.execute(version.insert().values(version="od07.store/v1"))
+            engine.dispose()
+        db = AdjustmentRepository(url, disposable_root=tmp_path)
+        db.append_action(a)
+        db.pin_context(pin)
+        out = run(pin)
+        db.append_bound_result(out, "context")
+        if case == "rollback-context":
+            with pytest.raises(ValueError):
+                db.pin_context(replace(pin, raw=replace(raw, observation_id="different")))
+            assert db.get_result(out.output_digest) == out.canonical_json
+        db.close()
+        db = AdjustmentRepository(url, disposable_root=tmp_path)
+        assert db.get_result(out.output_digest) == out.canonical_json
