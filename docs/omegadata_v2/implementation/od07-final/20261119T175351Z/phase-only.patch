+        "claims": tuple(
+            v
+            for v in x.calendar.claims
+            if v.calendar_version == x.calendar_version
+            and (v.known_from is None or v.known_from <= x.known_at)
+        ),
+        "coverage": tuple(
+            v
+            for v in x.calendar.coverage
+            if v.calendar_version == x.calendar_version
+            and (v.known_from is None or v.known_from <= x.known_at)
+        ),
+    }
