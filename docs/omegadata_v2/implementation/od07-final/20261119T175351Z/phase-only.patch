+        with pytest.raises(ValueError):
+            db.append_bound_result(bad, "context", expected_result_id=out.output_digest)
+        assert db.get_result(out.output_digest) == out.canonical_json
+        return
+    with pytest.raises(ValueError):
+        db.append_bound_result(bad, "context")
