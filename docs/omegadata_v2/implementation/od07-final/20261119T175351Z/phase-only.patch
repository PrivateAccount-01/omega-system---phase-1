+        "RAW_CLOSE"
+        if isinstance(action.parameters, c.Rights)
+        else "REINVESTMENT_PRICE"
+        if isinstance(action.parameters, c.Dividend)
+        else "SUCCESSOR_VALUATION"
+    )
+    if ref.observation_type != expected_type:
