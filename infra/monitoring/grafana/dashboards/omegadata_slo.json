{
  "title": "OmegaData SLO and Data Quality",
  "panels": [
    {
      "type": "stat",
      "title": "API Availability (5m)",
      "targets": [
        {
          "expr": "1 - (sum(rate(omegadata_api_requests_total{status=~\"5..\"}[5m])) / sum(rate(omegadata_api_requests_total[5m])))",
          "legendFormat": "availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.995},
              {"color": "green", "value": 0.999}
            ]
          }
        }
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "API P95 Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(omegadata_api_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.5},
              {"color": "red", "value": 0.75}
            ]
          }
        }
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "NSE Failover Events",
      "targets": [
        {
          "expr": "sum by(source)(increase(omegadata_download_failover_total[1h]))",
          "legendFormat": "{{source}}"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Cross-Source Validation Outcomes",
      "targets": [
        {
          "expr": "sum by(result)(increase(omegadata_validation_total[1h]))",
          "legendFormat": "{{result}}"
        }
      ],
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Alerts Routed",
      "targets": [
        {
          "expr": "sum by(severity,status)(increase(omegadata_alerts_total[1h]))",
          "legendFormat": "{{severity}} {{status}}"
        }
      ],
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8}
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  }
}
